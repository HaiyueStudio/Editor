{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyue.dev/schema/animation-editor/project-1.json",
  "title": "Haiyue Animation Editor project v1",
  "type": "object",
  "required": ["format", "schemaVersion", "id", "name", "composition", "assets", "nodes", "timeline"],
  "properties": {
    "format": { "const": "haiyue-animation-editor-project@1" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "composition": { "$ref": "#/$defs/composition" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "timeline": { "$ref": "#/$defs/timeline" },
    "stateMachine": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/stateMachine" }
      ]
    },
    "editor": { "$ref": "#/$defs/editorMetadata" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "finiteNumber": { "type": "number" },
    "vec2": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }],
      "minItems": 2,
      "maxItems": 2
    },
    "color": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4
    },
    "composition": {
      "type": "object",
      "required": ["canvas", "duration", "frameRate", "endBehavior"],
      "properties": {
        "canvas": {
          "type": "object",
          "required": ["width", "height", "coordinateSystem"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "coordinateSystem": { "const": "screen-y-down" }
          },
          "additionalProperties": false
        },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "endBehavior": { "enum": ["hold", "loop", "destroy"] }
      },
      "additionalProperties": false
    },
    "assetSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "uri"],
          "properties": {
            "kind": { "const": "external" },
            "uri": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "fileName", "mimeType", "encoding", "data"],
          "properties": {
            "kind": { "const": "embedded" },
            "fileName": { "type": "string", "minLength": 1 },
            "mimeType": { "type": "string", "minLength": 1 },
            "encoding": { "const": "base64" },
            "data": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "type", "source", "delivery"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["image", "audio", "binary"] },
        "source": { "$ref": "#/$defs/assetSource" },
        "delivery": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 },
            "mimeType": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "minLength": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "colorSpace": { "enum": ["srgb", "linear"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec2" },
        "rotation": { "$ref": "#/$defs/finiteNumber" },
        "scale": { "$ref": "#/$defs/vec2" },
        "anchor": { "$ref": "#/$defs/vec2" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "componentRecord": {
      "type": "object",
      "required": ["id", "component"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "component": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "role": { "enum": ["fill", "stroke", "gradient", "modifier", "text-animator", "text-selector"] },
              "index": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "effectRecord": {
      "type": "object",
      "required": ["id", "effect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "effect": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["tint", "fill", "opacity", "color-matrix", "blur", "drop-shadow"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "compositeLayer": {
      "type": "object",
      "required": ["id", "kind", "sourceNodeId", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["mask", "matte"] },
        "sourceNodeId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["alpha", "alpha-inverted", "luma", "luma-inverted"] },
        "operation": { "enum": ["add", "subtract", "intersect", "difference"] },
        "feather": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "expansion": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "transform", "components", "effects", "compositeLayers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parent": { "$ref": "#/$defs/id" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "transform": { "$ref": "#/$defs/transform" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/componentRecord" } },
        "effects": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/effectRecord" } },
        "compositeLayers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/compositeLayer" } },
        "extensions": { "type": "object" },
        "editor": {
          "type": "object",
          "properties": {
            "hidden": { "type": "boolean" },
            "locked": { "type": "boolean" },
            "expanded": { "type": "boolean" },
            "color": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "componentProperty": {
      "enum": [
        "sprite.uv-rect",
        "vector.morph",
        "vector.fill.color",
        "vector.fill.opacity",
        "vector.gradient.start",
        "vector.gradient.end",
        "vector.gradient.stops",
        "vector.stroke.color",
        "vector.stroke.opacity",
        "vector.stroke.width",
        "vector.stroke.dash-offset",
        "vector.modifier.trim-start",
        "vector.modifier.trim-end",
        "vector.modifier.trim-offset",
        "vector.modifier.round-radius",
        "text.selector.start",
        "text.selector.end",
        "text.selector.offset",
        "text.selector.amount",
        "text.animator.position",
        "text.animator.scale",
        "text.animator.rotation",
        "text.animator.opacity",
        "text.animator.fill-color",
        "text.animator.tracking"
      ]
    },
    "effectProperty": {
      "enum": [
        "tint.black", "tint.white", "tint.amount",
        "fill.color", "fill.opacity", "opacity.value",
        "color-matrix.matrix", "blur.radius",
        "drop-shadow.color", "drop-shadow.opacity", "drop-shadow.offset", "drop-shadow.blur"
      ]
    },
    "trackTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "nodeId", "property"],
          "properties": {
            "kind": { "const": "node-transform" },
            "nodeId": { "$ref": "#/$defs/id" },
            "property": { "enum": ["position", "rotation", "scale", "opacity"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "nodeId", "componentId", "property"],
          "properties": {
            "kind": { "const": "component-property" },
            "nodeId": { "$ref": "#/$defs/id" },
            "componentId": { "$ref": "#/$defs/id" },
            "partId": { "$ref": "#/$defs/id" },
            "property": { "$ref": "#/$defs/componentProperty" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "nodeId", "effectId", "property"],
          "properties": {
            "kind": { "const": "effect-property" },
            "nodeId": { "$ref": "#/$defs/id" },
            "effectId": { "$ref": "#/$defs/id" },
            "property": { "$ref": "#/$defs/effectProperty" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "nodeId", "compositeLayerId", "property"],
          "properties": {
            "kind": { "const": "composite-property" },
            "nodeId": { "$ref": "#/$defs/id" },
            "compositeLayerId": { "$ref": "#/$defs/id" },
            "property": { "const": "expansion" }
          },
          "additionalProperties": false
        }
      ]
    },
    "easing": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "$ref": "#/$defs/finiteNumber" },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "time", "value", "interpolation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "time": { "type": "number", "minimum": 0 },
        "value": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finiteNumber" } },
        "interpolation": { "enum": ["step", "linear", "cubic-bezier"] },
        "easing": { "$ref": "#/$defs/easing" },
        "spatialIn": { "$ref": "#/$defs/vec2" },
        "spatialOut": { "$ref": "#/$defs/vec2" }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "target", "valueSize", "keyframes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "target": { "$ref": "#/$defs/trackTarget" },
        "valueSize": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "enabled": { "type": "boolean" },
        "color": { "type": "string" },
        "keyframes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keyframe" } }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "required": ["id", "name", "start", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string" }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["tracks", "clips"],
      "properties": {
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      },
      "additionalProperties": false
    },
    "stateMachineParameter": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name", "type", "defaultValue"],
          "properties": { "name": { "$ref": "#/$defs/id" }, "type": { "const": "float" }, "defaultValue": { "$ref": "#/$defs/finiteNumber" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "type", "defaultValue"],
          "properties": { "name": { "$ref": "#/$defs/id" }, "type": { "const": "integer" }, "defaultValue": { "type": "integer" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "type", "defaultValue"],
          "properties": { "name": { "$ref": "#/$defs/id" }, "type": { "const": "boolean" }, "defaultValue": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "type"],
          "properties": { "name": { "$ref": "#/$defs/id" }, "type": { "const": "trigger" } },
          "additionalProperties": false
        }
      ]
    },
    "stateMotion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "clipId"],
          "properties": { "kind": { "const": "clip" }, "clipId": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "parameter", "children"],
          "properties": {
            "kind": { "const": "blend-1d" },
            "parameter": { "$ref": "#/$defs/id" },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "object",
                "required": ["threshold", "motion"],
                "properties": { "threshold": { "$ref": "#/$defs/finiteNumber" }, "motion": { "$ref": "#/$defs/stateMotion" } },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "algorithm", "parameterX", "parameterY", "children"],
          "properties": {
            "kind": { "const": "blend-2d" },
            "algorithm": { "enum": ["cartesian", "directional"] },
            "parameterX": { "$ref": "#/$defs/id" },
            "parameterY": { "$ref": "#/$defs/id" },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "object",
                "required": ["position", "motion"],
                "properties": { "position": { "$ref": "#/$defs/vec2" }, "motion": { "$ref": "#/$defs/stateMotion" } },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": ["parameter", "operator"],
      "properties": {
        "parameter": { "$ref": "#/$defs/id" },
        "operator": { "enum": ["greater", "greater-or-equal", "less", "less-or-equal", "equal", "not-equal", "is-true", "is-false", "triggered"] },
        "value": { "type": ["number", "boolean"] }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "name", "motion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "motion": { "$ref": "#/$defs/stateMotion" },
        "speed": { "$ref": "#/$defs/finiteNumber" },
        "speedParameter": { "$ref": "#/$defs/id" },
        "loop": { "enum": ["once", "repeat", "ping-pong"] },
        "editorPosition": { "$ref": "#/$defs/vec2" }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to", "conditions", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "$ref": "#/$defs/id" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "duration": { "type": "number", "minimum": 0 },
        "hasExitTime": { "type": "boolean" },
        "exitTime": { "type": "number", "minimum": 0 },
        "destinationOffset": { "type": "number", "minimum": 0 },
        "interruption": { "enum": ["none", "source", "destination", "source-then-destination", "destination-then-source"] }
      },
      "additionalProperties": false
    },
    "stateLayer": {
      "type": "object",
      "required": ["id", "name", "initialStateId", "states", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "initialStateId": { "$ref": "#/$defs/id" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "blendMode": { "enum": ["override", "additive"] },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "mask": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stateMachine": {
      "type": "object",
      "required": ["format", "id", "name", "parameters", "layers"],
      "properties": {
        "format": { "const": "haiyue-animation-state-machine@1" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parameters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/stateMachineParameter" } },
        "layers": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/stateLayer" } }
      },
      "additionalProperties": false
    },
    "editorMetadata": {
      "type": "object",
      "properties": {
        "activePanel": { "enum": ["timeline", "state-machine"] },
        "viewport": {
          "type": "object",
          "required": ["zoom", "center", "showGrid"],
          "properties": {
            "zoom": { "type": "number", "exclusiveMinimum": 0 },
            "center": { "$ref": "#/$defs/vec2" },
            "showGrid": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "timeline": {
          "type": "object",
          "required": ["playhead", "pixelsPerSecond", "scrollX"],
          "properties": {
            "playhead": { "type": "number", "minimum": 0 },
            "pixelsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "scrollX": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
