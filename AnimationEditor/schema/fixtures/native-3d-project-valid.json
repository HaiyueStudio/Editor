  "nodes": [
    {
      "id": "camera",
      "name": "Camera",
      "transform": {
        "translation": [0, 1.5, 5],
        "rotation": [0, 0, 0, 1],
        "scale": [1, 1, 1]
      },
      "components": [
        {
          "id": "camera:main",
          "kind": "camera3d",
          "projection": {
            "kind": "perspective",
            "fovYRadians": 0.7853981633974483,
            "near": 0.1,
            "far": 100
          }
        }
      ]
    },
    {
      "id": "ground",
      "name": "Ground",
      "transform": {
        "translation": [0, -1, 0],
        "rotation": [0, 0, 0, 1],
        "scale": [5, 0.1, 5]
      },
      "components": [
        {
          "id": "ground:mesh",
          "kind": "primitive3d",
          "primitive": "box",
          "materialId": "material:hero"
        }
      ]
    },
    {
      "id": "character",
      "name": "Character",
      "transform": {
        "translation": [0, 0, 0],
        "rotation": [0, 0, 0, 1],
        "scale": [1, 1, 1]
      },
      "components": [
        {
          "id": "character:model",
          "kind": "model3d",
          "resource": "model:character",
          "materialOverrides": [
            { "slot": "Body", "materialId": "material:hero" }
          ]
        }
      ]
    },
    {
      "id": "sparks",
      "name": "Sparks",
      "parent": "character",
      "transform": {
        "translation": [0, 1, 0],
        "rotation": [0, 0, 0, 1],
        "scale": [1, 1, 1]
      },
      "components": [
        {
          "id": "sparks:emitter",
          "kind": "particle3d",
          "descriptor": {
            "maxParticles": 256,
            "emissionRate": 24,
            "burst": 8,
            "duration": 2,
            "loop": true,
            "seed": 1732584193,
            "lifetime": [0.4, 0.8],
            "speed": [0.5, 1.5],
            "direction": [0, 1, 0],
            "spread": 0.5,
            "gravity": [0, -1, 0],
            "startSize": [0.04, 0.08],
            "endSize": [0, 0.02],
            "rotation": [0, 6.283185307179586],
            "angularVelocity": [-1, 1],
            "startColor": [1, 0.8, 0.2, 1],
