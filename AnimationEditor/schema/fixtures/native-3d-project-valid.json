        "sourceHash": "sha256-source-character"
      }
    },
    {
      "id": "texture:spark",
      "name": "Spark",
      "type": "image",
      "source": { "kind": "external", "uri": "fixtures/spark.png" },
      "delivery": {
        "uri": "assets/spark.png",
        "mimeType": "image/png",
        "integrity": "sha256-contract-spark"
      }
    }
  ],
  "materials": [
