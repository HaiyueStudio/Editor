  "timeline": {
    "clips": [
      {
        "id": "clip:idle",
        "name": "Idle",
        "duration": 2,
        "tracks": [
          {
            "id": "track:root-translation",
            "name": "Root Translation",
            "binding": {
              "id": "binding:root-translation",
              "target": { "kind": "node-id", "nodeId": "character" },
              "path": "transform.translation",
              "valueType": "vec3",
              "valueSize": 3
            },
            "interpolation": "linear",
            "keyframes": [
              { "id": "key:root-0", "time": 0, "value": [0, 0, 0] },
              { "id": "key:root-2", "time": 2, "value": [0, 0.05, 0] }
            ]
          },
          {
            "id": "track:spine-rotation",
            "name": "Spine Rotation",
            "binding": {
              "id": "binding:spine-rotation",
              "target": { "kind": "node-path", "segments": ["character", "Armature", "Spine"] },
              "path": "transform.rotation",
              "valueType": "quaternion",
              "valueSize": 4
            },
            "interpolation": "linear",
            "keyframes": [
              { "id": "key:spine-0", "time": 0, "value": [0, 0, 0, 1] },
              { "id": "key:spine-2", "time": 2, "value": [0, 0.043619387, 0, 0.999048222] }
            ]
          },
          {
            "id": "track:face-morph",
            "name": "Face Morph",
            "binding": {
              "id": "binding:face-morph",
              "target": { "kind": "slot", "slot": "character:Face" },
              "path": "morph.weights",
              "valueType": "weights",
              "valueSize": 2
            },
            "interpolation": "linear",
            "keyframes": [
              { "id": "key:face-0", "time": 0, "value": [0, 0] },
              { "id": "key:face-1", "time": 1, "value": [0.5, 0.2] },
              { "id": "key:face-2", "time": 2, "value": [0, 0] }
            ]
          },
          {
            "id": "track:material-color",
            "name": "Material Color",
            "binding": {
              "id": "binding:material-color",
              "target": { "kind": "slot", "slot": "material:hero" },
              "path": "property",
              "component": "material3d",
              "property": "baseColorFactor",
              "valueType": "vec4",
              "valueSize": 4
            },
            "interpolation": "linear",
            "keyframes": [
              { "id": "key:material-0", "time": 0, "value": [0.2, 0.55, 1, 1] },
              { "id": "key:material-2", "time": 2, "value": [0.4, 0.7, 1, 1] }
            ]
          },
          {
            "id": "track:camera-fov",
            "name": "Camera FOV",
            "binding": {
              "id": "binding:camera-fov",
              "target": { "kind": "node-id", "nodeId": "camera" },
              "path": "property",
              "component": "camera3d",
              "property": "fovYRadians",
              "valueType": "scalar",
              "valueSize": 1
            },
            "interpolation": "step",
            "keyframes": [
              { "id": "key:camera-0", "time": 0, "value": [0.7853981633974483] },
              { "id": "key:camera-2", "time": 2, "value": [0.8726646259971648] }
            ]
          }
        ],
        "events": []
      }
    ]
  },
  "stateMachine": {
    "format": "haiyue-animation3d-state-machine@1",
    "id": "machine:character",
    "name": "Character",
    "parameters": [],
    "layers": [
      {
        "id": "layer:base",
        "name": "Base",
        "initialStateId": "state:idle",
        "states": [
          {
            "id": "state:idle",
            "name": "Idle",
            "motion": { "kind": "clip", "clipId": "clip:idle" },
            "loop": "repeat"
          }
        ],
        "transitions": [],
        "blendMode": "override",
        "weight": 1,
        "mask": {
          "include": [
            "binding:root-translation",
            "binding:spine-rotation",
            "binding:face-morph",
            "binding:material-color",
            "binding:camera-fov"
          ]
        }
      }
    ]
  },
  "editor": {
    "selectedNodeIds": ["character"],
    "activeClipId": "clip:idle",
    "viewportCamera": {
      "position": [4, 3, 6],
      "target": [0, 1, 0],
      "up": [0, 1, 0]
    },
    "gizmo": { "tool": "translate", "space": "local" }
  }
}
