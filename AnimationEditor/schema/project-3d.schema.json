{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyue.dev/schema/animation-editor/project-3d/1.json",
  "title": "Haiyue Animation Editor native 3D project v1",
  "type": "object",
  "required": ["format", "schemaVersion", "mode", "id", "name", "composition", "assets", "materials", "nodes", "timeline"],
  "properties": {
    "format": { "const": "haiyue-animation-editor-project-3d@1" },
    "schemaVersion": { "const": 1 },
    "mode": { "const": "3d" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "composition": { "$ref": "#/$defs/composition" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "materials": {
      "type": "array",
      "items": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/material" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/node" }
    },
    "timeline": { "$ref": "#/$defs/timeline" },
    "stateMachine": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/stateMachine" }
      ]
    },
    "editor": { "$ref": "#/$defs/editor" }
  },
  "additionalProperties": false,
  "$defs": {
    "composition": {
      "type": "object",
      "required": ["viewport", "coordinateSystem", "duration", "frameRate", "endBehavior"],
      "properties": {
        "viewport": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/viewport" },
        "coordinateSystem": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/coordinateSystem" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "endBehavior": { "enum": ["hold", "loop", "destroy"] }
      },
      "additionalProperties": false
    },
    "assetSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "uri"],
          "properties": {
            "kind": { "const": "external" },
            "uri": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "encoding", "data"],
          "properties": {
            "kind": { "const": "embedded" },
            "encoding": { "const": "base64" },
            "data": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "assetDelivery": {
      "type": "object",
      "required": ["uri", "mimeType"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:https://|data:|(?!(?:blob|file|javascript):)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@%/-]+)$"
        },
        "mimeType": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "type", "source", "delivery"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["image", "audio", "binary", "model"] },
        "source": { "$ref": "#/$defs/assetSource" },
        "delivery": { "$ref": "#/$defs/assetDelivery" },
        "dependencyAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "importer": { "type": "string", "minLength": 1 },
            "sourceFormat": { "type": "string", "minLength": 1 },
            "sourceHash": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "time", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "time": { "type": "number", "minimum": 0 },
        "value": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "inTangent": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "outTangent": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "binding", "interpolation", "keyframes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "binding": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/binding" },
        "interpolation": { "enum": ["step", "linear", "cubic-spline"] },
        "keyframes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keyframe" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "interpolation": { "const": "cubic-spline" } },
            "required": ["interpolation"]
          },
          "then": {
            "properties": {
              "keyframes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "inTangent": { "type": "array" },
                    "outTangent": { "type": "array" }
                  },
                  "required": ["inTangent", "outTangent"]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "time", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "time": { "type": "number", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "required": ["id", "name", "duration", "tracks", "events"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["clips"],
      "properties": {
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "properties": {
        "selectedNodeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "activeClipId": { "type": "string", "minLength": 1 },
        "viewportCamera": {
          "type": "object",
          "required": ["position", "target", "up"],
          "properties": {
            "position": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/vec3" },
            "target": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/vec3" },
            "up": { "$ref": "https://haiyue.dev/schema/animation/extension/animation-3d/1.json#/$defs/vec3" }
          },
          "additionalProperties": false
        },
        "gizmo": {
          "type": "object",
          "required": ["tool", "space"],
          "properties": {
            "tool": { "enum": ["translate", "rotate", "scale"] },
            "space": { "enum": ["local", "world"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
