{
  "id": "./",
  "name": "HaiYue Voxel Editor",
  "short_name": "Voxel Editor",
  "description": "A WebGPU voxel modeling, animation and game-asset editor.",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0e131b",
  "theme_color": "#0e131b",
  "categories": ["graphics", "productivity", "developer"],
  "icons": [
    {
      "src": "./pwa/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
