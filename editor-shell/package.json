{
  "name": "@haiyue/editor-shell",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced-authoring": {
      "types": "./dist/advanced-authoring/index.d.ts",
      "import": "./dist/advanced-authoring/index.js"
    },
    "./advanced-authoring.css": "./dist/advanced-authoring/advanced-authoring.css"
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/advanced-authoring/*.test.mjs"
  },
  "dependencies": {
    "@haiyue/editor-plugin-sdk": "0.1.0",
    "@haiyue/editor-platform": "0.1.0",
    "@haiyue/ui": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.2.0"
  }
}
