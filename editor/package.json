{
  "name": "@haiyue/editor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiyueStudio/Editor.git",
    "directory": "editor"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "build:app": "npm run build && node ../scripts/run-editor-app-kit.mjs assemble",
    "build:pwa": "npm run build:app",
    "build:test": "node ../scripts/build-rollup-once.mjs rollup.test.config.js",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev": "rollup -c rollup.config.js --watch",
    "preview:pwa": "npm run build:pwa && node ../scripts/run-editor-app-kit.mjs preview",
    "app:check": "npm run build:app && node ../scripts/run-editor-app-kit.mjs validate",
    "electron:start": "npm run build:app && electron .",
    "electron:pack": "npm run build:app && node ../scripts/run-editor-app-kit.mjs electron-pack",
    "electron:smoke": "node ../scripts/run-editor-app-kit.mjs electron-smoke",
    "electron:dist": "npm run build:app && node ../scripts/run-editor-app-kit.mjs electron-dist",
    "test:e2e": "npm run build && node ../scripts/editor-e2e/createSaveExportPlay.mjs && node ../scripts/editor-e2e/gltfImportSaveExportPlay.mjs && node ../scripts/editor-e2e/tetrisStarterPlay.mjs && node ../scripts/editor-e2e/rayTracingPreviewLifecycle.mjs",
    "test:e2e:ray-tracing": "npm run build && node ../scripts/editor-e2e/rayTracingPreviewLifecycle.mjs",
    "test:e2e:tetris": "npm run build && node ../scripts/editor-e2e/tetrisStarterPlay.mjs",
    "test": "node ../scripts/build-rollup-once.mjs rollup.test.config.js && node scripts/check-boundaries.mjs && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@haiyue/editor-app-kit": "0.1.0",
    "@haiyue/editor-platform": "0.1.0",
    "@haiyue/editor-plugin-sdk": "0.1.0",
    "@haiyue/editor-shell": "0.1.0",
    "@haiyue/animation-spec": ">=0.1.0 <0.2.0",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.33.0",
    "@haiyue/extensions": ">=0.1.0 <0.2.0",
    "@haiyue/shader-language": ">=0.1.0 <0.2.0",
    "@haiyue/ui": ">=0.1.0 <0.2.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/javascript": "^1.5.4",
    "codemirror": "^6.0.1",
    "jszip": "^3.10.1",
    "@haiyue/engine": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@webgpu/types": "^0.1.40",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "rollup": "^4.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.6.0",
    "typescript": "^5.2.0"
  }
}
